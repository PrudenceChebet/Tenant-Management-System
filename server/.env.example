# Copy this file to .env and fill in your own values.

# Database. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP default (root user, no password):
DATABASE_URL="mysql://root:@localhost:3306/tms"
PORT=4000

# Secret used to sign login tokens. Any long random text. Keep it private.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Address of the Python AI service (step 4). Until it exists,
# the API uses keyword rules to set the priority.
AI_SERVICE_URL="http://localhost:8000"

# Photo storage (optional). Paste the "API environment variable" from your
# Cloudinary dashboard. Without it, photos are saved in server/uploads.
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
