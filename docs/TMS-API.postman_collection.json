{
  "info": {
    "name": "TMS API",
    "description": "Tenant Management System API. Run the requests from top to bottom. The two Login requests save the tokens automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "tenantToken",
      "value": ""
    },
    {
      "key": "landlordToken",
      "value": ""
    },
    {
      "key": "requestId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login as tenant (Brian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"brian@tms.test\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"tenantToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as landlord (Grace)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"landlord@tms.test\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"landlordToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (tenant)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenantToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Register a new tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Wambui\",\n  \"email\": \"jane@tms.test\",\n  \"phone\": \"0712000005\",\n  \"password\": \"Password123\",\n  \"role\": \"TENANT\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Tenant",
      "item": [
        {
          "name": "Report a maintenance request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            },
            "description": "clientId is a new random UUID each time ({{$guid}}). The AI service isn't built yet, so prioritySource will be RULE.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenantToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{$guid}}\",\n  \"title\": \"Pipe burst in kitchen\",\n  \"description\": \"Water is flooding the kitchen floor from under the sink\",\n  \"category\": \"PLUMBING\",\n  \"locationInUnit\": \"kitchen\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"requestId\", pm.response.json().request.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenantToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Request detail with timeline",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{requestId}}"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenantToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel my request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{requestId}}",
                "status"
              ]
            },
            "description": "Only works while the request is still SUBMITTED.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tenantToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Landlord",
      "item": [
        {
          "name": "All requests (sorted by priority)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{landlordToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Only SUBMITTED requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests?status=SUBMITTED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests?status=SUBMITTED"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{landlordToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Assign request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{requestId}}",
                "status"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{landlordToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ASSIGNED\",\n  \"note\": \"Plumber booked for tomorrow 9am\"\n}"
            }
          }
        },
        {
          "name": "Start work",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{requestId}}",
                "status"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{landlordToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          }
        },
        {
          "name": "Mark resolved",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{requestId}}",
                "status"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{landlordToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\",\n  \"note\": \"Pipe replaced\"\n}"
            }
          }
        },
        {
          "name": "Override priority",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/requests/{{requestId}}/priority",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "requests",
                "{{requestId}}",
                "priority"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{landlordToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"MEDIUM\",\n  \"reason\": \"Water already shut off at the main valve\"\n}"
            }
          }
        },
        {
          "name": "My properties and units",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{landlordToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Add a property",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{landlordToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mathari Apartments\",\n  \"location\": \"Nyeri, Mathari\"\n}"
            }
          }
        },
        {
          "name": "Add a unit to property 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/properties/1/units",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "properties",
                "1",
                "units"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{landlordToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"C1\"\n}"
            }
          }
        },
        {
          "name": "Link tenant to unit 4 (B2)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/units/4/tenant",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "units",
                "4",
                "tenant"
              ]
            },
            "description": "Use null as tenantEmail to mark the unit vacant.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{landlordToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantEmail\": \"jane@tms.test\"\n}"
            }
          }
        }
      ]
    }
  ]
}